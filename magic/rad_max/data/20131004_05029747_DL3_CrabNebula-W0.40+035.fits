                                  NAXIS   =                    2 / 2-dimensional binary table                     NAXIS1  =                   16 / width of table in bytes                        NAXIS2  =                    1 / number of rows in table                        PCOUNT  =                    0 / size of special data area                      GCOUNT  =                    1 / one data group (required keyword)              TFIELDS =                    2 / number of fields in each row                   TTYPE1  = 'START   '           / label for field   1                            TFORM1  = '1D      '           / data format of field: 8-byte DOUBLE            TUNIT1  = 's       '           / physical unit of field                         TTYPE2  = 'STOP    '           / label for field   2                            TFORM2  = '1D      '           / data format of field: 8-byte DOUBLE            TUNIT2  = 's       '           / physical unit of field                         EXTNAME = 'GTI     '           / name of this binary table extension            HDUCLASS= 'GADF    '           / conformant with GADF specifications            HDUDOC  = 'https://github.com/open-gamma-ray-astro/gamma-astro-data-formats' / dHDUVERS = '0.2     '           / version of the format                          HDUCLAS1= 'GTI     '           / primary extension class                        MJDREFI =                52706 / [d] integer part of reference MJD              MJDREFF =                   0. / [d] fractional part of reference MJD           TIMEUNIT= 's       '           / time unit                                      TIMESYS = 'UTC     '           / time system                                    TIMEREF = 'local   '           / time reference frame                           END                                                                                                                                                                                                           